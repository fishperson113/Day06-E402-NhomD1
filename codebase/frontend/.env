# API base URL (fallback when window.location.origin is unavailable)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Polling interval in milliseconds for auto-refresh
NEXT_PUBLIC_POLL_INTERVAL=5000

# Locale for number formatting
NEXT_PUBLIC_LOCALE=vi-VN

# Currency suffix
NEXT_PUBLIC_CURRENCY= đ

# Set to "true" to enable Encore dev toolbar
NEXT_PUBLIC_ENABLE_TOOLBAR=false
